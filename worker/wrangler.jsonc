{
  // Sends "get up and walk" reminders for The Long Way Back. Free plan is enough.
  "name": "long-way-back-push",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  // No id on purpose: wrangler creates the storage on first deploy.
  "kv_namespaces": [{ "binding": "SUBS" }],
  // Ten to every hour. The Worker itself decides whose waking hours it is.
  "triggers": { "crons": ["50 * * * *"] },
  "observability": { "enabled": true }
}
